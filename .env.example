# BOT_TOKEN and PANEL_API_KEY are required — fill before running
BOT_TOKEN=0000000000:REPLACE_ME
ADMIN_IDS=123456789
SUPPORT_USERNAME=helpersmmtg

# true = SQLite + MemoryStorage (no Docker/Postgres/Redis)
LOCAL_MODE=true
SQLITE_PATH=data/bot.db

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smm_bot
POSTGRES_USER=smm
POSTGRES_PASSWORD=change_me_strong_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

PANEL_API_URL=https://smmpanelus.com/api/v2
PANEL_API_KEY=REPLACE_PANEL_API_KEY

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/your_bot

CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false
CRYPTOBOT_ASSET=USDT,TON,BTC

STARS_ENABLED=true

# Referral: % of referred user's order payments → referrer balance
REFERRAL_PERCENT=7

APP_ENV=development
LOG_LEVEL=INFO
CURRENCY=USD
DEFAULT_LANGUAGE=ru
SERVICES_SYNC_INTERVAL_MINUTES=60
ORDER_STATUS_POLL_SECONDS=60
CACHE_TTL_SECONDS=3600

WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
